# Copy to .env and fill in. Never commit .env.
# Every value here is also read on Modal: push_modal_secret.py copies .env into the Modal secret.

# ---- Required ---------------------------------------------------------------
# Site to track (no protocol). Subdomains count too, so example.com also matches blog.example.com
TARGET_DOMAIN=
# Oxylabs Web API key (dashboard -> Web API -> API keys)
OXYLABS_API_KEY=
# ID of the Google Sheet that holds the tracker tab (the part between /d/ and /edit in its URL)
GOOGLE_SHEET_ID=
# Where the weekly ranking email goes (comma-separate several addresses)
REPORT_EMAIL_TO=

# ---- Markets ----------------------------------------------------------------
# Comma-separated, in the order of the sheet's columns. Presets: US UK CA AU NZ IE IN DE FR ES.
# Any other market: CODE=google_domain:country:locale, e.g. MARKETS=US,NL=nl:NL:nl_NL
MARKETS=US

# ---- Schedule, dates and report ---------------------------------------------
# IANA timezone for the run date and the Modal cron
TIMEZONE=UTC
# Cron for the weekly Modal run (minute hour day-of-month month day-of-week). Default: Monday 08:00
SCHEDULE_CRON=0 8 * * 1
# strftime format for the date written in row 1 of each new column group, e.g. %d/%m/%Y
DATE_FORMAT=%Y-%m-%d
# Email subject; {domain} and {date} are filled in
REPORT_SUBJECT=Google rankings for {domain} - {date}

# ---- Optional ---------------------------------------------------------------
# Tracker tab name in the sheet
TRACKER_TAB=Tracker
# Organic results to check (default 100) and hard cap on result pages per search (default 15)
MAX_RESULTS=100
MAX_PAGES=15
# Searches run in parallel; above 3, Oxylabs tends to fault on some queries
MAX_WORKERS=3
# Modal app and secret names (the secret defaults to the app name)
MODAL_APP_NAME=weekly-rank-tracker
MODAL_SECRET_NAME=
# Set to 1 to save every raw Oxylabs response to .tmp/ for debugging
SAVE_RAW=
