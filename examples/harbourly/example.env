# Fictional example project: Harbourly, an invented boat-hire software company.
# Nothing here is real; .example domains never resolve. Used by the public test suite.
TARGET_DOMAIN=harbourly.example
OXYLABS_API_KEY=example-not-a-real-key
GOOGLE_SHEET_ID=example-sheet-id
REPORT_EMAIL_TO=jonas.okafor@harbourly.example
MARKETS=UK,US
TIMEZONE=Europe/London
SCHEDULE_CRON=0 7 * * 1
DATE_FORMAT=%Y-%m-%d
REPORT_SUBJECT=Harbourly weekly rankings - {date}
MODAL_APP_NAME=harbourly-rank-tracker
